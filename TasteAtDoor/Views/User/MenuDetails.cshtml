@model TasteAtDoor.Models.ViewModels.MenuDetailsPageViewModel

@{
    ViewData["Title"] = $"{Model.MenuItem.Name} Details";
    var item = Model.MenuItem;

    string? imageSource = null;

    if (item.ImageData is not null &&
        item.ImageData.Length > 0 &&
        !string.IsNullOrWhiteSpace(item.ImageContentType))
    {
        imageSource = $"data:{item.ImageContentType};base64,{Convert.ToBase64String(item.ImageData)}";
    }
}

<div class="user-page menu-details-page">
    <div class="page-heading">
        <a asp-controller="User"
           asp-action="RestaurantMenu"
           asp-route-id="@item.CaretakerId"
           class="btn-secondary-main mb-3">
            Back to Catering Packages
        </a>

        <h1>@item.Name</h1>

        <p>
            <strong>Caterer:</strong> @Model.RestaurantName
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.RestaurantAddress))
        {
            <p>
                <strong>Service Area:</strong> @Model.RestaurantAddress
            </p>
        }

        <p>
            <strong>Distance:</strong> @Model.DistanceKm.ToString("0.0") km
        </p>

        @if (Model.CanOrder)
        {
            <div class="success-box">
                This caterer is within 15 km. You can request this package.
            </div>
        }
        else
        {
            <div class="text-danger">
                This caterer is outside 15 km. You can view all package details, but requesting is disabled.
            </div>
        }
    </div>

    <div id="cart-client-message" class="mb-3"></div>

    <div class="menu-detail-layout" data-package-card>
        <div class="menu-detail-image-panel">
            @if (!string.IsNullOrWhiteSpace(imageSource))
            {
                <img src="@imageSource"
                     alt="@item.Name"
                     class="menu-detail-image" />
            }
            else
            {
                <div class="menu-detail-image-placeholder">
                    No image
                </div>
            }
        </div>

        <div class="menu-detail-info-panel">
            <h2>@item.Name</h2>

            <div class="menu-rating-summary mb-3">
                <div class="menu-rating-card">
                    <span>Package Rating</span>
                    @if (Model.ReviewCount > 0)
                    {
                        <strong>⭐ @Model.AverageMenuRating.ToString("0.0") / 5</strong>
                    }
                    else
                    {
                        <strong>No rating yet</strong>
                    }
                </div>

                <div class="menu-rating-card">
                    <span>Caterer Rating</span>
                    @if (Model.ReviewCount > 0)
                    {
                        <strong>⭐ @Model.AverageCatererRating.ToString("0.0") / 5</strong>
                    }
                    else
                    {
                        <strong>No rating yet</strong>
                    }
                </div>

                <div class="menu-rating-card">
                    <span>Total Reviews</span>
                    <strong>@Model.ReviewCount</strong>
                </div>
            </div>

            <div class="menu-detail-section-card">
                <h3>Package Overview</h3>

                <p>@item.Description</p>

                <div class="menu-detail-info-grid">
                    <div>
                        <span>Price Per Person</span>
                        <strong>@item.Price.ToString("0.00") ₺</strong>
                    </div>

                    <div>
                        <span>Event Type</span>
                        <strong>@item.EventType</strong>
                    </div>

                    <div>
                        <span>Package Category</span>
                        <strong>@item.PackageCategory</strong>
                    </div>

                    <div>
                        <span>Guest Range</span>
                        <strong>@item.MinGuestCount - @item.MaxGuestCount guests</strong>
                    </div>
                </div>
            </div>

            <div class="menu-detail-section-card">
                <h3>Package Includes</h3>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (item.IncludesMainCourse)
                    {
                        <span class="badge bg-primary">Main Course</span>
                    }

                    @if (item.IncludesDessert)
                    {
                        <span class="badge bg-success">Dessert</span>
                    }

                    @if (item.IncludesSnacks)
                    {
                        <span class="badge bg-warning text-dark">Snacks</span>
                    }

                    @if (item.IncludesDrinks)
                    {
                        <span class="badge bg-info text-dark">Drinks</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(item.IncludedItems))
                {
                    <div class="menu-meta mb-3">
                        <strong>Included Items</strong>
                        <div>@item.IncludedItems</div>
                    </div>
                }
                else
                {
                    <p class="text-muted">No included item details were provided.</p>
                }

                @if (!string.IsNullOrWhiteSpace(item.ServiceDetails))
                {
                    <div class="menu-meta mb-3">
                        <strong>Service Details</strong>
                        <div>@item.ServiceDetails</div>
                    </div>
                }
                else
                {
                    <p class="text-muted">No service details were provided.</p>
                }

                @if (!string.IsNullOrWhiteSpace(item.LocationText))
                {
                    <div class="menu-meta mb-2">
                        <strong>Package Location / Address</strong>
                        <div>@item.LocationText</div>
                    </div>
                }
            </div>

            <div class="menu-detail-section-card">
                <h3>Choose Package Options</h3>

                @if (item.CustomizationGroups is null || !item.CustomizationGroups.Any())
                {
                    <p class="text-muted">
                        This catering package has no customization options.
                    </p>
                }
                else
                {
                    foreach (var group in item.CustomizationGroups.OrderBy(g => g.Id))
                    {
                        <div class="customization-select-group">
                            <h4>@group.Title</h4>

                            @if (group.Options is null || !group.Options.Any())
                            {
                                <p class="text-muted">
                                    No options in this group.
                                </p>
                            }
                            else
                            {
                                <div class="customization-choice-list">
                                    @foreach (var option in group.Options.OrderBy(o => o.Id))
                                    {
                                        <label class="customization-choice">
                                            <input type="checkbox"
                                                   class="js-customization-option"
                                                   data-option-id="@option.Id"
                                                   data-group-title="@group.Title"
                                                   data-option-name="@option.Name"
                                                   data-price-change="@option.PriceChange.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

                                            <span class="customization-choice-text">
                                                <strong>@option.Name</strong>

                                                @if (option.PriceChange > 0)
                                                {
                                                    <small>+ @option.PriceChange.ToString("0.00") ₺ / guest</small>
                                                }
                                                else if (option.PriceChange < 0)
                                                {
                                                    <small>@option.PriceChange.ToString("0.00") ₺ / guest</small>
                                                }
                                                else
                                                {
                                                    <small>No extra charge</small>
                                                }
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <div class="package-guest-box">
                <label class="form-label">Guest Count</label>

                <div class="package-guest-stepper">
                    <button type="button" class="guest-step-btn js-guest-step" data-step="-100">-100</button>
                    <button type="button" class="guest-step-btn js-guest-step" data-step="-10">-10</button>

                    <input type="number"
                           class="form-control package-guest-input js-package-guest-count"
                           min="@item.MinGuestCount"
                           max="@item.MaxGuestCount"
                           value="@item.MinGuestCount" />

                    <button type="button" class="guest-step-btn js-guest-step" data-step="10">+10</button>
                    <button type="button" class="guest-step-btn js-guest-step" data-step="100">+100</button>
                </div>

                <small class="text-muted">
                    You can type the guest count manually. It must be between @item.MinGuestCount and @item.MaxGuestCount guests.
                </small>
            </div>

            <div class="menu-detail-price-box">
                <span>Price Per Person With Options</span>
                <strong id="detail-total-price"
                        data-base-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        data-current-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @item.Price.ToString("0.00") ₺
                </strong>
            </div>

            <div class="menu-detail-price-box">
                <span>Estimated Package Total</span>
                <strong id="detail-package-total">
                    @((item.Price * item.MinGuestCount).ToString("0.00")) ₺
                </strong>
            </div>

            <div class="menu-detail-actions">
                @if (Model.CanOrder)
                {
                    <button type="button"
                            class="btn-main js-add-to-cart"
                            data-menu-id="@item.Id"
                            data-name="@item.Name"
                            data-description="@item.Description"
                            data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-min-guest-count="@item.MinGuestCount"
                            data-max-guest-count="@item.MaxGuestCount"
                            data-image-content-type="@item.ImageContentType"
                            data-image-base64="@(item.ImageData is not null ? Convert.ToBase64String(item.ImageData) : "")">
                        Add Selected Package to Cart
                    </button>
                }
                else
                {
                    <button class="btn-secondary-main" disabled>
                        Outside 15 km - Request Disabled
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="menu-reviews-section">
        <div class="page-header-row">
            <div>
                <h2 class="page-title">Customer Reviews</h2>
                <p class="page-subtitle">
                    Reviews are shown from customer ratings submitted for this catering package.
                </p>
            </div>
        </div>

        @if (!Model.Reviews.Any())
        {
            <div class="empty-state-card">
                <h3>No reviews yet</h3>
                <p>This catering package has not received any reviews yet.</p>
            </div>
        }
        else
        {
            <div class="menu-review-list">
                @foreach (var review in Model.Reviews)
                {
                    <div class="menu-review-card">
                        <div class="menu-review-header">
                            <div>
                                <h3>@review.CustomerName</h3>
                                <p>
                                    Request #@review.OrderId · @review.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                </p>
                            </div>

                            <div class="menu-review-ratings">
                                <span>Package: ⭐ @review.MenuRating / 5</span>
                                <span>Caterer: ⭐ @review.CatererRating / 5</span>
                            </div>
                        </div>

                        <div class="menu-review-body">
                            @if (string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-muted">
                                    No written comment.
                                </p>
                            }
                            else
                            {
                                <p>@review.Comment</p>
                            }
                        </div>

                        <div class="menu-review-footer">
                            <span>Package: @review.MenuItemName</span>
                            <span>Guest Count: @review.Quantity</span>
                            <span>Total: @review.LineTotal.ToString("0.00") ₺</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/cart-storage.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.TasteAtDoorCart) {
                window.TasteAtDoorCart.initMenuButtons("cart-client-message");
                window.TasteAtDoorCart.initCustomizationPricePreview();
            }
        });
    </script>
}
