@model TasteAtDoor.Models.ViewModels.LocationInputViewModel

@{
    ViewData["Title"] = "My Location";
}

<div class="auth-page">
    <div class="auth-card" style="max-width: 980px;">
        <h1>My Location</h1>

        <p>
            Click on the map to save your location. Caterer distances will be calculated from this point.
        </p>

        @if (TempData["Success"] is string success)
        {
            <div class="success-box">@success</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger mb-3">@error</div>
        }

        <form asp-controller="User" asp-action="MyLocation" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div id="locationMap"
                 style="width:100%; height:420px; border-radius:12px; background:#eee;">
            </div>

            <div class="mt-3">
                <strong>Selected address:</strong>
                <span id="selectedAddressText">@(Model.Address ?? "No location selected yet.")</span>
            </div>

            <input asp-for="Latitude" type="hidden" id="Latitude" />
            <input asp-for="Longitude" type="hidden" id="Longitude" />
            <input asp-for="Address" type="hidden" id="Address" />

            <span asp-validation-for="Latitude" class="text-danger d-block"></span>
            <span asp-validation-for="Longitude" class="text-danger d-block"></span>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button type="submit" class="btn-main">
                    Save My Location
                </button>

                <a asp-controller="User"
                   asp-action="Index"
                   class="btn-secondary-main">
                    View Caterers
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/location-save-map.js" asp-append-version="true"></script>

    <script async
            src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&loading=async&language=en&region=US&callback=initLocationSaveMap&libraries=marker,geocoding&v=weekly">
    </script>
}


