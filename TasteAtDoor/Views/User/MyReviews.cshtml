@model TasteAtDoor.Models.ViewModels.ReviewListPageViewModel

@{
    ViewData["Title"] = "My Reviews";
}

<div class="dashboard-shell">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">My Reviews</h1>
            <p class="page-subtitle">See every package and caterer rating you submitted.</p>
        </div>

        <a asp-controller="User" asp-action="Orders" class="btn-secondary-main">
            Back to Orders
        </a>
    </div>

    <div class="table-card">
        <form method="get" asp-controller="User" asp-action="MyReviews" class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Search</label>
                <input name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Order, menu, caterer, comment..." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Menu Rating</label>
                <input name="menuRating"
                       value="@Model.MenuRating"
                       type="number"
                       min="1"
                       max="5"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Caterer Rating</label>
                <input name="catererRating"
                       value="@Model.CatererRating"
                       type="number"
                       min="1"
                       max="5"
                       class="form-control" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn-main w-100">Filter</button>
            </div>
        </form>
    </div>

    <div class="table-card">
        @if (!Model.Reviews.Any())
        {
            <p>You have not submitted any reviews yet.</p>
        }
        else
        {
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Restaurant</th>
                        <th>Catering Package</th>
                        <th>Package Rating</th>
                        <th>Caterer Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var review in Model.Reviews)
                    {
                        <tr>
                            <td>#@review.OrderId</td>
                            <td>@review.CatererName</td>
                            <td>@review.MenuItemName</td>
                            <td>@review.MenuRating / 5</td>
                            <td>@review.CatererRating / 5</td>
                            <td>@(string.IsNullOrWhiteSpace(review.Comment) ? "-" : review.Comment)</td>
                            <td>@review.CreatedAt</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>Page @Model.Page / @Model.TotalPages</div>

            <div class="d-flex gap-2">
                @if (Model.Page > 1)
                {
                    <a class="btn-secondary-main"
                       asp-controller="User"
                       asp-action="MyReviews"
                       asp-route-search="@Model.Search"
                       asp-route-menuRating="@Model.MenuRating"
                       asp-route-catererRating="@Model.CatererRating"
                       asp-route-page="@(Model.Page - 1)">
                        Previous
                    </a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn-secondary-main"
                       asp-controller="User"
                       asp-action="MyReviews"
                       asp-route-search="@Model.Search"
                       asp-route-menuRating="@Model.MenuRating"
                       asp-route-catererRating="@Model.CatererRating"
                       asp-route-page="@(Model.Page + 1)">
                        Next
                    </a>
                }
            </div>
        </div>
    </div>
</div>

