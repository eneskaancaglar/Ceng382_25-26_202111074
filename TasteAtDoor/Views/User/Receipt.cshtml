@model TasteAtDoor.Models.Order

@{
    ViewData["Title"] = "Catering Receipt";
    var items = Model?.OrderItems?.ToList() ?? new List<TasteAtDoor.Models.OrderItem>();
}

<div class="dashboard-shell">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">Catering Receipt</h1>
            <p class="page-subtitle">
                Generated dynamically from your catering request data.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="User"
               asp-action="Orders"
               class="btn-secondary-main">
                Back to Requests
            </a>

            <a asp-controller="OrderChat"
               asp-action="Room"
               asp-route-id="@Model.Id"
               class="btn-main">
                Open Chat / Live Call
            </a>

            <a asp-controller="OrderDocument"
               asp-action="ReceiptPdf"
               asp-route-id="@Model.Id"
               class="btn-main">
                Download Receipt PDF
            </a>

            <a asp-controller="OrderDocument"
               asp-action="AgreementPdf"
               asp-route-id="@Model.Id"
               class="btn-secondary-main">
                Download Agreement PDF
            </a>

            <button type="button"
                    class="btn-secondary-main"
                    onclick="window.print()">
                Print Page
            </button>
        </div>
    </div>

    <div class="receipt-grid">
        <div class="table-card">
            <h3>Request Information</h3>
            <p><strong>Request ID:</strong> #@Model.Id</p>
            <p><strong>Request Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy HH:mm")</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Total Estimated Price:</strong> @Model.TotalPrice.ToString("0.00") TL</p>
        </div>

        <div class="table-card">
            <h3>Event Information</h3>
            <p><strong>Event Type:</strong> @Model.EventType</p>

            @if (Model.EventDate.HasValue)
            {
                <p><strong>Event Date:</strong> @Model.EventDate.Value.ToString("dd MMM yyyy HH:mm")</p>
            }
            else
            {
                <p><strong>Event Date:</strong> Not specified</p>
            }

            <p><strong>Total Guest Count:</strong> @Model.GuestCount</p>
            <p><strong>Event Address:</strong> @Model.EventAddress</p>

            @if (!string.IsNullOrWhiteSpace(Model.EventNote))
            {
                <p><strong>Event Note:</strong> @Model.EventNote</p>
            }
        </div>

        <div class="table-card">
            <h3>Customer Information</h3>
            <p><strong>Name:</strong> @(Model.ApplicationUser?.FullName ?? "Unknown Customer")</p>
            <p><strong>Email:</strong> @(Model.ApplicationUser?.Email ?? "No email")</p>
        </div>
    </div>

    <div class="table-card">
        <h3>Selected Catering Packages</h3>

        @if (!items.Any())
        {
            <p>No packages found for this request.</p>
        }
        else
        {
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Catering Package</th>
                        <th>Caterer</th>
                        <th>Guest Count</th>
                        <th>Base Price / Person</th>
                        <th>Final Price / Person</th>
                        <th>Package Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in items)
                    {
                        var customizations = item.SelectedCustomizations?.ToList()
                            ?? new List<TasteAtDoor.Models.OrderItemCustomization>();

                        <tr>
                            <td>
                                <strong>@(item.MenuItem?.Name ?? "Catering Package")</strong>

                                @if (customizations.Any())
                                {
                                    <ul class="user-option-list mt-2">
                                        @foreach (var customization in customizations)
                                        {
                                            <li>
                                                @customization.GroupTitle: @customization.OptionName

                                                @if (customization.PriceChange != 0)
                                                {
                                                    <span>
                                                        (@customization.PriceChange.ToString("0.00") TL / person)
                                                    </span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="cart-meta">No extra package option selected</div>
                                }
                            </td>

                            <td>@(item.MenuItem?.Caretaker?.FullName ?? "Caterer")</td>
                            <td>@item.Quantity</td>
                            <td>@item.BaseUnitPrice.ToString("0.00") TL</td>
                            <td>@item.FinalUnitPrice.ToString("0.00") TL</td>
                            <td>@item.LineTotal.ToString("0.00") TL</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

