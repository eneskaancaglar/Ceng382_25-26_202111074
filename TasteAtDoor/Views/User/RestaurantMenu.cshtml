@model TasteAtDoor.Models.ViewModels.RestaurantMenuPageViewModel

@{
    ViewData["Title"] = $"{Model.RestaurantName} Menu";

    string? restaurantLogoSource = null;

    if (Model.RestaurantLogoImageData is not null &&
        Model.RestaurantLogoImageData.Length > 0 &&
        !string.IsNullOrWhiteSpace(Model.RestaurantLogoImageContentType))
    {
        restaurantLogoSource = $"data:{Model.RestaurantLogoImageContentType};base64,{Convert.ToBase64String(Model.RestaurantLogoImageData)}";
    }
}

<div class="user-page restaurant-menu-page">
    <div class="restaurant-menu-hero">
        <a asp-controller="User" asp-action="Index" class="btn-secondary-main mb-3">
            Back to Restaurants
        </a>

        <div class="restaurant-menu-hero-content">
            <div class="restaurant-menu-logo-large">
                @if (!string.IsNullOrWhiteSpace(restaurantLogoSource))
                {
                    <img src="@restaurantLogoSource"
                         alt="@Model.RestaurantName"
                         class="restaurant-menu-logo-img" />
                }
                else
                {
                    <div class="restaurant-logo-placeholder restaurant-logo-placeholder-large">
                        @(string.IsNullOrWhiteSpace(Model.RestaurantName)
                            ? "R"
                            : Model.RestaurantName.Substring(0, 1).ToUpper())
                    </div>
                }
            </div>

            <div>
                <h1>@Model.RestaurantName</h1>

                @if (!string.IsNullOrWhiteSpace(Model.RestaurantBio))
                {
                    <p class="restaurant-bio-large">
                        @Model.RestaurantBio
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.RestaurantAddress))
                {
                    <p>
                        <strong>Address:</strong> @Model.RestaurantAddress
                    </p>
                }

                <p>
                    <strong>Distance:</strong> @Model.DistanceKm.ToString("0.0") km
                </p>

                @if (Model.CanOrder)
                {
                    <div class="success-box">
                        This restaurant is within 5 km. You can order from this restaurant.
                    </div>
                }
                else
                {
                    <div class="text-danger">
                        This restaurant is outside 5 km. You can view the menu but cannot order.
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="cart-client-message" class="mb-3"></div>

    @if (Model.MenuItems.Count == 0)
    {
        <div class="auth-card">
            <h2>No menu items</h2>
            <p>This restaurant has not added any menu items yet.</p>
        </div>
    }
    else
    {
        <div class="restaurant-menu-grid">
            @foreach (var item in Model.MenuItems)
            {
                string? imageSource = null;

                if (item.ImageData is not null && item.ImageData.Length > 0)
                {
                    imageSource = $"data:{item.ImageContentType};base64,{Convert.ToBase64String(item.ImageData)}";
                }

                <div class="restaurant-menu-card">
                    <div class="restaurant-menu-image-wrapper">
                        @if (!string.IsNullOrWhiteSpace(imageSource))
                        {
                            <img src="@imageSource"
                                 alt="@item.Name"
                                 class="restaurant-menu-image" />
                        }
                        else
                        {
                            <div class="menu-detail-image-placeholder">
                                No image
                            </div>
                        }
                    </div>

                    <div class="restaurant-menu-card-body">
                        <h3>@item.Name</h3>

                        <p class="restaurant-menu-description">
                            @item.Description
                        </p>

                        <p>
                            <strong>Distance:</strong> @Model.DistanceKm.ToString("0.0") km
                        </p>

                        <p>
                            <strong>Price:</strong> @item.Price.ToString("C")
                        </p>

                        @if (!Model.CanOrder)
                        {
                            <div class="text-danger mb-2">
                                You are outside 5 km. Ordering is disabled.
                            </div>
                        }

                        <div class="restaurant-menu-actions">
                            <a asp-controller="User"
                               asp-action="MenuDetails"
                               asp-route-id="@item.Id"
                               class="btn-secondary-main">
                                View Details
                            </a>

                            @if (Model.CanOrder)
                            {
                                <button type="button"
                                        class="btn-main js-add-to-cart"
                                        data-menu-id="@item.Id"
                                        data-name="@item.Name"
                                        data-description="@item.Description"
                                        data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-image-content-type="@item.ImageContentType"
                                        data-image-base64="@(item.ImageData is not null ? Convert.ToBase64String(item.ImageData) : "")">
                                    Add to Cart
                                </button>
                            }
                            else
                            {
                                <button class="btn-secondary-main" disabled>
                                    Outside 5 km
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/cart-storage.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.TasteAtDoorCart) {
                window.TasteAtDoorCart.initMenuButtons("cart-client-message");
            }
        });
    </script>
}