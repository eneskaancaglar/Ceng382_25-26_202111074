@model TasteAtDoor.Models.ViewModels.RestaurantListPageViewModel

@{
    ViewData["Title"] = "Available Caterers";
}

<div class="available-restaurants-page">
    <div class="available-hero">
        <div>
            <span class="available-eyebrow">TasteAtDoor</span>
            <h1>Available Caterers Near You</h1>
            <p>
                Choose a caterer first. Distances are calculated from your saved location.
                You can request catering packages from caterers within 15 km.
            </p>
        </div>

        <a asp-controller="User" asp-action="MyLocation" class="btn-secondary-main">
            Change My Location
        </a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger mb-3">@error</div>
    }

    @if (!Model.UserLocationSaved)
    {
        <div class="empty-state-card">
            <h2>Save your location first</h2>
            <p>You must save your location before viewing caterers near you.</p>

            <a asp-controller="User" asp-action="MyLocation" class="btn-main">
                Save My Location
            </a>
        </div>
    }
    else
    {
        <form asp-controller="User" asp-action="Index" method="get" class="restaurant-search-bar">
            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="Search by caterer name, address, or description..."
                   class="form-control" />

            <button type="submit" class="btn-main">
                Search
            </button>
        </form>

        @if (Model.Restaurants.Count == 0)
        {
            <div class="empty-state-card">
                <h2>No caterers found</h2>
                <p>No caterer has saved a location yet, or your search did not match anything.</p>
            </div>
        }
        else
        {
            <div class="restaurant-card-grid caterer-card-grid">
                @foreach (var caterer in Model.Restaurants)
                {
                    string? logoSource = null;

                    if (caterer.LogoImageData is not null &&
                        caterer.LogoImageData.Length > 0 &&
                        !string.IsNullOrWhiteSpace(caterer.LogoImageContentType))
                    {
                        logoSource = $"data:{caterer.LogoImageContentType};base64,{Convert.ToBase64String(caterer.LogoImageData)}";
                    }

                    <div class="restaurant-card-modern caterer-card-modern">
                        <div class="restaurant-card-top">
                            <div class="restaurant-logo-box">
                                @if (!string.IsNullOrWhiteSpace(logoSource))
                                {
                                    <img src="@logoSource"
                                         alt="@caterer.RestaurantName"
                                         class="restaurant-logo-img" />
                                }
                                else
                                {
                                    <div class="restaurant-logo-placeholder">
                                        @(string.IsNullOrWhiteSpace(caterer.RestaurantName)
                                            ? "C"
                                            : caterer.RestaurantName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>

                            <div class="restaurant-status-pill @(caterer.CanOrder ? "status-open" : "status-closed")">
                                @(caterer.CanOrder ? "Within 15 km" : "Outside 15 km")
                            </div>
                        </div>

                        <div class="restaurant-card-body-modern caterer-card-body-modern">
                            <h3 class="caterer-card-title">
                                <span>@caterer.RestaurantName</span>

                                @if (caterer.CatererReviewCount > 0)
                                {
                                    <small class="rating-inline-badge">
                                        ⭐ @caterer.AverageCatererRating.ToString("0.0") / 5
                                        (@caterer.CatererReviewCount)
                                    </small>
                                }
                                else
                                {
                                    <small class="rating-inline-badge rating-empty">
                                        No rating yet
                                    </small>
                                }
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(caterer.Bio))
                            {
                                <p class="restaurant-bio">
                                    @caterer.Bio
                                </p>
                            }
                            else
                            {
                                <p class="restaurant-bio text-muted">
                                    No caterer description yet.
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(caterer.Address))
                            {
                                <p class="restaurant-meta">
                                    <strong>Address:</strong> @caterer.Address
                                </p>
                            }

                            <div class="restaurant-info-row">
                                <span>
                                    <strong>@caterer.DistanceKm.ToString("0.0") km</strong>
                                    away
                                </span>

                                <span>
                                    <strong>@caterer.MenuCount</strong>
                                    packages
                                </span>
                            </div>

                            @if (!caterer.CanOrder)
                            {
                                <p class="restaurant-warning">
                                    You can view this caterer and its packages, but requesting is disabled because this caterer is more than 15 km away.
                                </p>
                            }
                        </div>

                        <div class="restaurant-card-footer-modern caterer-card-footer-modern">
                            <a asp-controller="User"
                               asp-action="RestaurantMenu"
                               asp-route-id="@caterer.Id"
                               class="btn-main w-100">
                                View Catering Packages
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
