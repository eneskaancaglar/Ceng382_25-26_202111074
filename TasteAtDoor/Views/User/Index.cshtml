@model TasteAtDoor.Models.ViewModels.RestaurantListPageViewModel

@{
    ViewData["Title"] = "Available Menus";
}

<div class="available-restaurants-page">
    <div class="available-hero">
        <div>
            <span class="available-eyebrow">TasteAtDoor</span>
            <h1>Available Menus Near You</h1>
            <p>
                Choose a restaurant first. Distances are calculated from your saved location.
                You can order only from restaurants within 5 km.
            </p>
        </div>

        <a asp-controller="User" asp-action="MyLocation" class="btn-secondary-main">
            Change My Location
        </a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="text-danger mb-3">@error</div>
    }

    @if (!Model.UserLocationSaved)
    {
        <div class="empty-state-card">
            <h2>Save your location first</h2>
            <p>You must save your location before viewing restaurants near you.</p>

            <a asp-controller="User" asp-action="MyLocation" class="btn-main">
                Save My Location
            </a>
        </div>
    }
    else
    {
        <form asp-controller="User" asp-action="Index" method="get" class="restaurant-search-bar">
            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="Search by restaurant name, address, or description..."
                   class="form-control" />

            <button type="submit" class="btn-main">
                Search
            </button>
        </form>

        @if (Model.Restaurants.Count == 0)
        {
            <div class="empty-state-card">
                <h2>No restaurants found</h2>
                <p>No restaurant has saved a location yet, or your search did not match anything.</p>
            </div>
        }
        else
        {
            <div class="restaurant-card-grid">
                @foreach (var restaurant in Model.Restaurants)
                {
                    string? logoSource = null;

                    if (restaurant.LogoImageData is not null &&
                        restaurant.LogoImageData.Length > 0 &&
                        !string.IsNullOrWhiteSpace(restaurant.LogoImageContentType))
                    {
                        logoSource = $"data:{restaurant.LogoImageContentType};base64,{Convert.ToBase64String(restaurant.LogoImageData)}";
                    }

                    <div class="restaurant-card-modern">
                        <div class="restaurant-card-top">
                            <div class="restaurant-logo-box">
                                @if (!string.IsNullOrWhiteSpace(logoSource))
                                {
                                    <img src="@logoSource"
                                         alt="@restaurant.RestaurantName"
                                         class="restaurant-logo-img" />
                                }
                                else
                                {
                                    <div class="restaurant-logo-placeholder">
                                        @(string.IsNullOrWhiteSpace(restaurant.RestaurantName)
                                            ? "R"
                                            : restaurant.RestaurantName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>

                            <div class="restaurant-status-pill @(restaurant.CanOrder ? "status-open" : "status-closed")">
                                @(restaurant.CanOrder ? "Within 5 km" : "Outside 5 km")
                            </div>
                        </div>

                        <div class="restaurant-card-body-modern">
                            <h3>@restaurant.RestaurantName</h3>

                            @if (!string.IsNullOrWhiteSpace(restaurant.Bio))
                            {
                                <p class="restaurant-bio">
                                    @restaurant.Bio
                                </p>
                            }
                            else
                            {
                                <p class="restaurant-bio text-muted">
                                    No restaurant description yet.
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(restaurant.Address))
                            {
                                <p class="restaurant-meta">
                                    <strong>Address:</strong> @restaurant.Address
                                </p>
                            }

                            <div class="restaurant-info-row">
                                <span>
                                    <strong>@restaurant.DistanceKm.ToString("0.0") km</strong>
                                    away
                                </span>

                                <span>
                                    <strong>@restaurant.MenuCount</strong>
                                    menus
                                </span>
                            </div>

                            @if (!restaurant.CanOrder)
                            {
                                <p class="restaurant-warning">
                                    You can view the menu, but ordering is disabled because this restaurant is more than 5 km away.
                                </p>
                            }
                        </div>

                        <div class="restaurant-card-footer-modern">
                            <a asp-controller="User"
                               asp-action="RestaurantMenu"
                               asp-route-id="@restaurant.Id"
                               class="btn-main w-100">
                                View Menu
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>