@model TasteAtDoor.Models.ViewModels.MenuEditViewModel

@{
    ViewData["Title"] = "Edit Menu Item";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Edit Menu Item</h1>
        <p>Update your menu item information.</p>

        <form asp-controller="Caretaker" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LocationText"></label>
                <input asp-for="LocationText" class="form-control" placeholder="Example: Kızılay, Ankara" />
                <span asp-validation-for="LocationText" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ExistingImageBase64) && !string.IsNullOrWhiteSpace(Model.ExistingImageContentType))
            {
                <div class="form-group mb-3">
                    <label>Current Image</label>
                    <div>
                        <img src="data:@Model.ExistingImageContentType;base64,@Model.ExistingImageBase64"
                             alt="Current image"
                             style="max-width:220px; border-radius:12px;" />
                    </div>
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="ImageFile"></label>
                <input asp-for="ImageFile" type="file" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-main">Save Changes</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}