@model TasteAtDoor.Models.ViewModels.MenuEditViewModel

@{
    ViewData["Title"] = "Edit Catering Package";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Edit Catering Package</h1>
        <p>Update your catering package information.</p>

        <form asp-controller="Caretaker" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="Example: Premium Wedding Dinner Package" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price"></label>
                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0.01"
                       placeholder="Price per person" />
                <span asp-validation-for="Price" class="text-danger"></span>
                <small class="text-muted">
                    This price will be calculated per guest.
                </small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EventType"></label>
                <select asp-for="EventType" class="form-control">
                    <option value="Wedding">Wedding</option>
                    <option value="Engagement">Engagement</option>
                    <option value="Corporate Event">Corporate Event</option>
                    <option value="Birthday">Birthday</option>
                    <option value="Graduation">Graduation</option>
                    <option value="Meeting">Meeting</option>
                    <option value="General Event">General Event</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PackageCategory"></label>
                <select asp-for="PackageCategory" class="form-control">
                    <option value="Standard">Standard</option>
                    <option value="Premium">Premium</option>
                    <option value="Luxury">Luxury</option>
                    <option value="Dessert Package">Dessert Package</option>
                    <option value="Snack Package">Snack Package</option>
                    <option value="Drink Package">Drink Package</option>
                    <option value="Full Service">Full Service</option>
                </select>
                <span asp-validation-for="PackageCategory" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="MinGuestCount"></label>
                        <input asp-for="MinGuestCount"
                               class="form-control"
                               type="number"
                               min="1" />
                        <span asp-validation-for="MinGuestCount" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="MaxGuestCount"></label>
                        <input asp-for="MaxGuestCount"
                               class="form-control"
                               type="number"
                               min="1" />
                        <span asp-validation-for="MaxGuestCount" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Explain what this package is suitable for."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IncludedItems"></label>
                <textarea asp-for="IncludedItems"
                          class="form-control"
                          rows="4"
                          placeholder="Example: grilled chicken, rice, salad, baklava, nuts, soft drinks"></textarea>
                <span asp-validation-for="IncludedItems" class="text-danger"></span>
                <small class="text-muted">
                    Write foods, desserts, snacks, and drinks included in this package.
                </small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ServiceDetails"></label>
                <textarea asp-for="ServiceDetails"
                          class="form-control"
                          rows="3"
                          placeholder="Example: delivery included, service staff available, table setup optional"></textarea>
                <span asp-validation-for="ServiceDetails" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label>Package Includes</label>

                <div class="form-check">
                    <input asp-for="IncludesMainCourse" class="form-check-input" />
                    <label asp-for="IncludesMainCourse" class="form-check-label"></label>
                </div>

                <div class="form-check">
                    <input asp-for="IncludesDessert" class="form-check-input" />
                    <label asp-for="IncludesDessert" class="form-check-label"></label>
                </div>

                <div class="form-check">
                    <input asp-for="IncludesSnacks" class="form-check-input" />
                    <label asp-for="IncludesSnacks" class="form-check-label"></label>
                </div>

                <div class="form-check">
                    <input asp-for="IncludesDrinks" class="form-check-input" />
                    <label asp-for="IncludesDrinks" class="form-check-label"></label>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LocationText"></label>
                <input asp-for="LocationText"
                       class="form-control"
                       placeholder="Optional. Leave empty to use your saved caterer location." />
                <span asp-validation-for="LocationText" class="text-danger"></span>
                <small class="text-muted">
                    If this field is empty or cannot be validated, the saved caterer location will be used.
                </small>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ExistingImageBase64) &&
                        !string.IsNullOrWhiteSpace(Model.ExistingImageContentType))
            {
                <div class="form-group mb-3">
                    <label>Current Package Image</label>
                    <div>
                        <img src="data:@Model.ExistingImageContentType;base64,@Model.ExistingImageBase64"
                             alt="Current catering package image"
                             style="max-width:220px; border-radius:12px;" />
                    </div>
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="ImageFile"></label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
                <small class="text-muted">
                    Leave empty if you do not want to change the image.
                </small>
            </div>

            <button type="submit" class="btn-main">Save Package</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

