@model TasteAtDoor.Models.ViewModels.MenuCreateViewModel

@{
    ViewData["Title"] = "Create Menu Item";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Create Menu Item</h1>
        <p>Add a new menu item for your restaurant.</p>

        <form asp-controller="Caretaker" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LocationText"></label>
                <input asp-for="LocationText"
                       class="form-control"
                       placeholder="Optional. Leave empty to use your saved restaurant location." />
                <span asp-validation-for="LocationText" class="text-danger"></span>
                <small class="text-muted">
                    If this field is empty, the saved restaurant location will be used automatically.
                </small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageFile"></label>
                <input asp-for="ImageFile" type="file" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-main">Create</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}