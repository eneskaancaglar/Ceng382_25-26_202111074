@model TasteAtDoor.Models.ViewModels.CaretakerMenuListViewModel

@{
    ViewData["Title"] = "My Menus";
}

<div class="dashboard-shell">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">My Menu Items</h1>
            <p class="page-subtitle">Create, edit, customize, and manage your menu items.</p>
        </div>

        <a asp-controller="Caretaker" asp-action="Create" class="btn-main">Create Menu Item</a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="success-box">@successMessage</div>
    }

    <div class="table-card">
        <form method="get" asp-controller="Caretaker" asp-action="Index" class="row g-3">
            <div class="col-md-9">
                <label class="form-label">Search</label>
                <input name="search" value="@Model.Search" class="form-control" placeholder="Menu name, description, or location" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn-main w-100">Filter</button>
            </div>
        </form>
    </div>

    @if (!Model.MenuItems.Any())
    {
        <div class="empty-box">
            <h3>No menu items found</h3>
            <p>You have not created any matching menu items yet.</p>
        </div>
    }
    else
    {
        <div class="menu-grid">
            @foreach (var item in Model.MenuItems)
            {
                <div class="menu-card">
                    <img src="data:@item.ImageContentType;base64,@Convert.ToBase64String(item.ImageData)"
                         alt="@item.Name"
                         class="menu-card-image" />

                    <div class="menu-card-header">
                        <h3>@item.Name</h3>
                        <span class="menu-price">@item.Price.ToString("0.00")</span>
                    </div>

                    <p class="menu-description">@item.Description</p>

                    <div class="menu-meta">
                        Location:
                        <strong>@item.LocationText</strong>
                    </div>

                    <div class="hero-buttons">
                        <a asp-controller="Caretaker"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn-main">
                            Edit
                        </a>

                        <a asp-controller="MenuCustomization"
                           asp-action="Index"
                           asp-route-menuItemId="@item.Id"
                           class="btn-secondary-main">
                            Customize
                        </a>

                        <form asp-controller="Caretaker"
                              asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post">
                            <button type="submit" class="btn-secondary-main">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="table-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>Page @Model.Page / @Model.TotalPages</div>

                <div class="d-flex gap-2">
                    @if (Model.Page > 1)
                    {
                        <a class="btn-secondary-main"
                           asp-controller="Caretaker"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Page - 1)">
                            Previous
                        </a>
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn-secondary-main"
                           asp-controller="Caretaker"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Page + 1)">
                            Next
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>