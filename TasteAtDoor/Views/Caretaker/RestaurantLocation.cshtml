@model TasteAtDoor.Models.ViewModels.LocationInputViewModel

@{
    ViewData["Title"] = "Restaurant Location";
}

<div class="auth-page">
    <div class="auth-card" style="max-width: 980px;">
        <h1>Restaurant Location</h1>
        <p>Click on the map to save your caterer location. Customers within 15 km can order from you.</p>

        @if (TempData["Success"] is string success)
        {
            <div class="success-box">@success</div>
        }

        <form asp-controller="Caretaker" asp-action="RestaurantLocation" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div id="locationMap" style="width:100%; height:420px; border-radius:12px; background:#eee;"></div>

            <div class="mt-3">
                <strong>Selected address:</strong>
                <span id="selectedAddressText">@(Model.Address ?? "No location selected yet.")</span>
            </div>

            <input asp-for="Latitude" type="hidden" id="Latitude" />
            <input asp-for="Longitude" type="hidden" id="Longitude" />
            <input asp-for="Address" type="hidden" id="Address" />

            <span asp-validation-for="Latitude" class="text-danger d-block"></span>
            <span asp-validation-for="Longitude" class="text-danger d-block"></span>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button type="submit" class="btn-main">Save Restaurant Location</button>
                <a asp-controller="Caretaker" asp-action="Index" class="btn-secondary-main">Back to My Menus</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/location-save-map.js" asp-append-version="true"></script>

    <script async
            src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&loading=async&callback=initLocationSaveMap&libraries=marker,geocoding&v=weekly">
    </script>
}