@model TasteAtDoor.Models.ViewModels.OrderChatRoomViewModel

@{
    ViewData["Title"] = $"Request Chat #{Model.OrderId}";
}

<div class="dashboard-shell">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">Request Chat #@Model.OrderId</h1>
            <p class="page-subtitle">
                Customer and caterer can communicate about the catering request.
            </p>
        </div>

        <div class="hero-buttons">
            @if (User.IsInRole("User"))
            {
                <a asp-controller="User"
                   asp-action="Orders"
                   class="btn-secondary-main">
                    Back to My Requests
                </a>

                <a asp-controller="User"
                   asp-action="Receipt"
                   asp-route-id="@Model.OrderId"
                   class="btn-main">
                    View Receipt
                </a>
            }
            else if (User.IsInRole("Caretaker"))
            {
                <a asp-controller="Caretaker"
                   asp-action="Dashboard"
                   class="btn-secondary-main">
                    Back to Dashboard
                </a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="Orders"
                   class="btn-secondary-main">
                    Back to Requests
                </a>
            }
        </div>
    </div>

    @await Html.PartialAsync("_OrderVoiceCall", Model.OrderId)

    <div class="order-chat-info-grid">
        <div class="order-chat-info-card">
            <h3>Request Information</h3>
            <p><strong>Request ID:</strong> #@Model.OrderId</p>
            <p><strong>Status:</strong> @Model.OrderStatus</p>
            <p><strong>Created:</strong> @Model.OrderDate.ToString("dd MMM yyyy HH:mm")</p>
        </div>

        <div class="order-chat-info-card">
            <h3>Customer</h3>
            <p><strong>Name:</strong> @Model.CustomerName</p>

            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
            {
                <p><strong>Email:</strong> @Model.CustomerEmail</p>
            }
        </div>

        <div class="order-chat-info-card">
            <h3>Caterer</h3>
            <p><strong>Name:</strong> @Model.CatererName</p>

            @if (!string.IsNullOrWhiteSpace(Model.CatererEmail))
            {
                <p><strong>Email:</strong> @Model.CatererEmail</p>
            }
        </div>
    </div>

    <div class="order-chat-card">
        <div class="order-chat-header">
            <div>
                <h3>Messages</h3>
                <p class="page-subtitle">
                    Messages are saved to this catering request.
                </p>
            </div>
        </div>

        @if (TempData["ChatError"] is string chatError)
        {
            <div class="alert alert-danger m-3">
                @chatError
            </div>
        }

        <div id="chatMessages" class="order-chat-messages">
            @if (Model.Messages is null || !Model.Messages.Any())
            {
                <div class="order-chat-loading">
                    No messages yet. Start the conversation.
                </div>
            }
            else
            {
                foreach (var message in Model.Messages)
                {
                    var isMine = message.SenderId == Model.CurrentUserId;

                    <div class="order-chat-message @(isMine ? "order-chat-message-mine" : "order-chat-message-other")">
                        <div class="order-chat-bubble">
                            <div class="order-chat-meta">
                                <strong>@message.SenderName</strong>
                                <span>@message.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </div>

                            <div class="order-chat-text">
                                @message.MessageText
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <form asp-controller="OrderChat"
              asp-action="SendMessage"
              asp-route-rawId="@Model.OrderId"
              method="post"
              class="order-chat-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="orderId" value="@Model.OrderId" />

            <textarea name="messageText"
                      class="form-control"
                      rows="2"
                      maxlength="1000"
                      placeholder="Write your message..."></textarea>

            <button type="submit" class="btn-main">
                Send
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/order-call.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const messages = document.getElementById("chatMessages");

            if (messages) {
                messages.scrollTop = messages.scrollHeight;
            }
        });
    </script>
}

