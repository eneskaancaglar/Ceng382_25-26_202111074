@model TasteAtDoor.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    var recentOrders = Model.RecentOrders ?? new List<TasteAtDoor.Models.Order>();
    var recentLogs = Model.RecentLogs ?? new List<TasteAtDoor.Models.AppLog>();
}

<style>
    .admin-dashboard {
        display: grid;
        gap: 24px;
    }

    .admin-hero {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        padding: 34px;
        color: #fff;
        background:
            radial-gradient(circle at 15% 10%, rgba(255,255,255,.26), transparent 30%),
            linear-gradient(135deg, #111827 0%, #3F2B96 52%, #7A0613 100%);
        box-shadow: 0 24px 55px rgba(17, 24, 39, .25);
    }

    .admin-hero::before {
        content: "";
        position: absolute;
        right: -80px;
        top: -80px;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: rgba(255,255,255,.13);
    }

    .admin-hero::after {
        content: "";
        position: absolute;
        right: 80px;
        bottom: -95px;
        width: 210px;
        height: 210px;
        border-radius: 50%;
        background: rgba(255,255,255,.10);
    }

    .admin-hero-inner {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1fr;
        gap: 28px;
        align-items: center;
    }

    .admin-kicker {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 8px 14px;
        background: rgba(255,255,255,.17);
        border: 1px solid rgba(255,255,255,.24);
        font-size: .78rem;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .admin-hero h1 {
        margin: 0;
        max-width: 820px;
        font-size: clamp(2.1rem, 4vw, 3.7rem);
        line-height: 1.02;
        font-weight: 950;
        letter-spacing: -.045em;
    }

    .admin-hero p {
        max-width: 800px;
        margin: 16px 0 0;
        color: rgba(255,255,255,.9);
        font-size: 1.06rem;
        line-height: 1.65;
    }

    .admin-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
    }

    .admin-btn-primary,
    .admin-btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        border-radius: 999px;
        padding: 11px 18px;
        text-decoration: none;
        font-weight: 900;
        transition: .2s ease;
    }

    .admin-btn-primary {
        background: #fff;
        color: #111827 !important;
        box-shadow: 0 14px 26px rgba(0,0,0,.18);
    }

    .admin-btn-primary:hover,
    .admin-btn-ghost:hover {
        transform: translateY(-2px);
    }

    .admin-btn-ghost {
        color: #fff !important;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.34);
    }

    .admin-hero-panel {
        padding: 22px;
        border-radius: 24px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.22);
        backdrop-filter: blur(12px);
    }

    .admin-hero-panel strong {
        display: block;
        font-size: 2.4rem;
        line-height: 1;
        margin-bottom: 8px;
    }

    .admin-hero-panel span {
        display: block;
        color: rgba(255,255,255,.86);
        line-height: 1.5;
    }

    .admin-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .admin-stat-card,
    .admin-card,
    .admin-table-card {
        background: rgba(255,255,255,.95);
        border: 1px solid rgba(36, 33, 36, .08);
        border-radius: 24px;
        box-shadow: 0 18px 42px rgba(36, 33, 36, .08);
    }

    .admin-stat-card {
        padding: 20px;
    }

    .admin-stat-label {
        color: #6F6870;
        font-weight: 900;
        font-size: .78rem;
        letter-spacing: .07em;
        text-transform: uppercase;
    }

    .admin-stat-value {
        margin-top: 8px;
        color: #242124;
        font-size: 2rem;
        line-height: 1.05;
        font-weight: 950;
        letter-spacing: -.035em;
    }

    .admin-stat-hint {
        margin-top: 8px;
        color: #6F6870;
        font-size: .92rem;
    }

    .admin-section-head {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: flex-end;
        margin-top: 4px;
    }

    .admin-section-head h2 {
        margin: 0;
        color: #242124;
        font-size: 1.45rem;
        font-weight: 950;
        letter-spacing: -.02em;
    }

    .admin-section-head p {
        margin: 6px 0 0;
        color: #6F6870;
    }

    .admin-action-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .admin-card {
        display: block;
        padding: 22px;
        min-height: 155px;
        color: #242124 !important;
        text-decoration: none;
        transition: .2s ease;
    }

    .admin-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 24px 50px rgba(36, 33, 36, .13);
    }

    .admin-card-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        margin-bottom: 18px;
        background: #EEF2FF;
        color: #3F2B96;
        font-size: 1.2rem;
        font-weight: 950;
    }

    .admin-card h3 {
        margin: 0 0 8px;
        font-size: 1.05rem;
        font-weight: 950;
    }

    .admin-card p {
        margin: 0;
        color: #6F6870;
        line-height: 1.55;
        font-size: .94rem;
    }

    .admin-two-column {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .admin-table-card {
        padding: 24px;
        overflow: hidden;
    }

    .admin-table-card h2 {
        margin: 0 0 14px;
        font-weight: 950;
        font-size: 1.25rem;
    }

    .admin-clean-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .admin-clean-table th {
        color: #6F6870;
        font-size: .78rem;
        letter-spacing: .05em;
        text-transform: uppercase;
        padding: 0 12px 4px;
    }

    .admin-clean-table td {
        background: #f8fafc;
        padding: 13px 12px;
        border-top: 1px solid rgba(36, 33, 36, .06);
        border-bottom: 1px solid rgba(36, 33, 36, .06);
        font-size: .92rem;
    }

    .admin-clean-table td:first-child {
        border-left: 1px solid rgba(36, 33, 36, .06);
        border-radius: 14px 0 0 14px;
        font-weight: 900;
    }

    .admin-clean-table td:last-child {
        border-right: 1px solid rgba(36, 33, 36, .06);
        border-radius: 0 14px 14px 0;
    }

    .admin-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 6px 10px;
        background: #EEF2FF;
        color: #3F2B96;
        font-size: .78rem;
        font-weight: 900;
    }

    .admin-empty {
        border-radius: 18px;
        padding: 22px;
        background: #f8fafc;
        color: #6F6870;
        text-align: center;
    }

    @@media (max-width: 1100px) {
        .admin-hero-inner,
        .admin-stat-grid,
        .admin-action-grid,
        .admin-two-column {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .admin-hero {
            padding: 24px;
        }

        .admin-hero-inner,
        .admin-stat-grid,
        .admin-action-grid,
        .admin-two-column {
            grid-template-columns: 1fr;
        }

        .admin-section-head {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="dashboard-shell admin-dashboard">
    <section class="admin-hero">
        <div class="admin-hero-inner">
            <div>
                <div class="admin-kicker">Admin control center</div>
                <h1>Monitor users, orders, logs, ratings, and platform activity.</h1>
                <p>
                    This dashboard gives a polished overview of the TasteAtDoor system.
                    It is designed for demo clarity: users, roles, orders, revenue, logs,
                    ratings, and recent backend activity are visible from one place.
                </p>

                <div class="admin-actions">
                    <a asp-controller="Admin" asp-action="Users" class="admin-btn-primary">Manage Users</a>
                    <a asp-controller="Admin" asp-action="Orders" class="admin-btn-ghost">Orders</a>
                    <a asp-controller="Admin" asp-action="Logs" class="admin-btn-ghost">System Logs</a>
                    <a asp-controller="Admin" asp-action="Ratings" class="admin-btn-ghost">Ratings</a>
                </div>
            </div>

        </div>
    </section>

    <section class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-label">Total Users</div>
            <div class="admin-stat-value">@Model.TotalUsers</div>
            <div class="admin-stat-hint">All registered accounts.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Customers</div>
            <div class="admin-stat-value">@Model.TotalCustomers</div>
            <div class="admin-stat-hint">Users with customer role.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Caterers</div>
            <div class="admin-stat-value">@Model.TotalCaretakers</div>
            <div class="admin-stat-hint">Users with caterer role.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Admins</div>
            <div class="admin-stat-value">@Model.TotalAdmins</div>
            <div class="admin-stat-hint">Administrator accounts.</div>
        </div>
    </section>

    <section class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-label">Total Orders</div>
            <div class="admin-stat-value">@Model.TotalOrders</div>
            <div class="admin-stat-hint">All catering requests.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Completed Orders</div>
            <div class="admin-stat-value">@Model.CompletedOrders</div>
            <div class="admin-stat-hint">Requests marked as completed.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Packages</div>
            <div class="admin-stat-value">@Model.TotalMenuItems</div>
            <div class="admin-stat-hint">Catering packages in the system.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Backend Logs</div>
            <div class="admin-stat-value">@Model.TotalLogs</div>
            <div class="admin-stat-hint">Saved system activity records.</div>
        </div>
    </section>

    <section class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-label">Total Reviews</div>
            <div class="admin-stat-value">@Model.TotalReviews</div>
            <div class="admin-stat-hint">Customer rating records.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Average Package Rating</div>
            <div class="admin-stat-value">@Model.AverageMenuRating.ToString("0.0") / 5</div>
            <div class="admin-stat-hint">Average menu score.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Average Caterer Rating</div>
            <div class="admin-stat-value">@Model.AverageCatererRating.ToString("0.0") / 5</div>
            <div class="admin-stat-hint">Average caterer score.</div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-label">Demo Message</div>
            <div class="admin-stat-value">Backend</div>
            <div class="admin-stat-hint">Logs and statistics should come from backend data.</div>
        </div>
    </section>

    <section>
        <div class="admin-section-head">
            <div>
                <h2>Quick admin actions</h2>
                <p>Use these shortcuts to present the admin part professionally.</p>
            </div>
        </div>

        <div class="admin-action-grid">
            <a asp-controller="Admin" asp-action="Users" class="admin-card">
                <div class="admin-card-icon">01</div>
                <h3>User Management</h3>
                <p>Review users, roles, contact data, and account statistics.</p>
            </a>

            <a asp-controller="Admin" asp-action="Orders" class="admin-card">
                <div class="admin-card-icon">02</div>
                <h3>Order Monitoring</h3>
                <p>Filter and inspect catering request records.</p>
            </a>

            <a asp-controller="Admin" asp-action="Ratings" class="admin-card">
                <div class="admin-card-icon">03</div>
                <h3>Rating Review</h3>
                <p>Check menu and caterer review activity.</p>
            </a>

            <a asp-controller="Admin" asp-action="Logs" class="admin-card">
                <div class="admin-card-icon">04</div>
                <h3>System Logs</h3>
                <p>Show backend-generated application activity records.</p>
            </a>
        </div>
    </section>

    <section class="admin-two-column">
        <div class="admin-table-card">
            <h2>Recent orders</h2>

            @if (!recentOrders.Any())
            {
                <div class="admin-empty">No recent orders.</div>
            }
            else
            {
                <table class="admin-clean-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>User</th>
                            <th>Status</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in recentOrders)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@(order.ApplicationUser?.FullName ?? order.ApplicationUser?.Email ?? "-")</td>
                                <td><span class="admin-badge">@order.Status</span></td>
                                <td>@order.TotalPrice.ToString("0.00") TL</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="admin-table-card">
            <h2>Recent backend logs</h2>

            @if (!recentLogs.Any())
            {
                <div class="admin-empty">No recent logs.</div>
            }
            else
            {
                <table class="admin-clean-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Event</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in recentLogs)
                        {
                            <tr>
                                <td>@log.CreatedAt.ToString("dd MMM HH:mm")</td>
                                <td><span class="admin-badge">@log.EventType</span></td>
                                <td>@(log.UserEmail ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>
</div>