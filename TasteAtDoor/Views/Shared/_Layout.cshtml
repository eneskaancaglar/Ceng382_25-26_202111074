<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Taste At Door</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar custom-navbar">
            <div class="container-fluid navbar-inner">
                <a class="navbar-brand brand-text" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Taste At Door Logo" class="site-logo" />
                    <span>Taste At Door</span>
                </a>

                <div class="top-links">
                    <a asp-controller="Home" asp-action="Index">Home</a>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        @if (User.IsInRole("Caretaker"))
                        {
                            <a asp-controller="Caretaker" asp-action="Index">My Menus</a>
                        }

                        @if (User.IsInRole("User"))
                        {
                            <a asp-controller="User" asp-action="Index">Browse Menus</a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index">Admin</a>
                        }

                        <a asp-controller="Account" asp-action="Index">Account</a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="auth-inline-form">
                            <button type="submit" class="auth-link-button">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register">Register</a>
                        <a asp-controller="Account" asp-action="Login">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="page-wrapper">
        <aside class="sidebar">
            <h3>Navigation</h3>
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    @if (User.IsInRole("Caretaker"))
                    {
                        <li><a asp-controller="Caretaker" asp-action="Index">My Menu Items</a></li>
                        <li><a asp-controller="Caretaker" asp-action="Create">Create Menu Item</a></li>
                    }

                    @if (User.IsInRole("User"))
                    {
                        <li><a asp-controller="User" asp-action="Index">Available Menus</a></li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                    }
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer">
        <p>© 2026 Taste At Door - All rights reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>