@{
    ViewData["Title"] = "Package Cart";
}

<div class="dashboard-shell">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">Package Cart</h1>
            <p class="page-subtitle">
                Review selected catering packages and update guest counts before agreement and payment.
            </p>
        </div>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">
            @success
        </div>
    }

    <div id="cart-empty-state" class="empty-box" style="display:none;">
        <h3>Your cart is empty</h3>
        <p>Add catering packages from the caterer package page.</p>
    </div>

    <div id="cart-items-container" class="cart-stack"></div>

    <div id="cart-summary-box" class="cart-summary-box" style="display:none;">
        <h3 id="cart-total-price">Total Price: 0.00</h3>

        <div class="checkout-button-row">
            <form id="agreement-form"
                  asp-controller="Cart"
                  asp-action="Agreement"
                  method="post"
                  class="cart-agreement-form">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="cart-json-input"
                       name="cartJson"
                       value="" />

                <button type="submit" class="btn-main">
                    Review Agreement and Continue
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart-storage.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (!window.TasteAtDoorCart) {
                return;
            }

            const agreementForm = document.getElementById("agreement-form");
            const cartJsonInput = document.getElementById("cart-json-input");

            function formatMoney(value) {
                return new Intl.NumberFormat("tr-TR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(value) + " TL";
            }

            function escapeHtml(value) {
                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function clampQuantity(value, minGuestCount, maxGuestCount) {
                return window.TasteAtDoorCart.clampQuantity(value, minGuestCount, maxGuestCount);
            }

            function getTotal(cart) {
                return cart.reduce((sum, item) => sum + (item.finalUnitPrice * item.quantity), 0);
            }

            function syncAgreementCartJson() {
                if (!cartJsonInput) {
                    return;
                }

                const cart = window.TasteAtDoorCart.getCart();
                cartJsonInput.value = JSON.stringify(cart);
            }

            function renderSelectedOptions(item) {
                if (!item.selectedOptions || item.selectedOptions.length === 0) {
                    return `<div class="cart-meta">No extra package option selected</div>`;
                }

                const items = item.selectedOptions.map(option => {
                    const priceHtml = option.priceChange !== 0
                        ? ` <span class="option-price-change">(${formatMoney(option.priceChange)} / person)</span>`
                        : "";

                    return `<li>${escapeHtml(option.groupTitle)}: ${escapeHtml(option.optionName)}${priceHtml}</li>`;
                }).join("");

                return `<ul class="user-option-list">${items}</ul>`;
            }

            function updateQuantity(signature, newQuantity) {
                const cart = window.TasteAtDoorCart.getCart();

                const found = cart.find(item => item.signature === signature);

                if (!found) {
                    return;
                }

                found.quantity = clampQuantity(
                    newQuantity,
                    found.minGuestCount || 1,
                    found.maxGuestCount || 100000
                );

                window.TasteAtDoorCart.saveCart(cart);
                render();
            }

            function changeQuantity(signature, delta) {
                const cart = window.TasteAtDoorCart.getCart();

                const found = cart.find(item => item.signature === signature);

                if (!found) {
                    return;
                }

                const nextQuantity = (found.quantity || found.minGuestCount || 1) + delta;

                found.quantity = clampQuantity(
                    nextQuantity,
                    found.minGuestCount || 1,
                    found.maxGuestCount || 100000
                );

                window.TasteAtDoorCart.saveCart(cart);
                render();
            }

            function removeItem(signature) {
                const cart = window.TasteAtDoorCart
                    .getCart()
                    .filter(item => item.signature !== signature);

                window.TasteAtDoorCart.saveCart(cart);
                render();
            }

            function render() {
                const container = document.getElementById("cart-items-container");
                const emptyBox = document.getElementById("cart-empty-state");
                const summaryBox = document.getElementById("cart-summary-box");
                const totalBox = document.getElementById("cart-total-price");

                const cart = window.TasteAtDoorCart.getCart();

                container.innerHTML = "";

                if (cart.length === 0) {
                    emptyBox.style.display = "block";
                    summaryBox.style.display = "none";
                    syncAgreementCartJson();
                    return;
                }

                emptyBox.style.display = "none";
                summaryBox.style.display = "block";

                cart.forEach(item => {
                    const minGuestCount = item.minGuestCount || 1;
                    const maxGuestCount = item.maxGuestCount || 100000;
                    const lineTotal = item.finalUnitPrice * item.quantity;

                    const card = document.createElement("div");
                    card.className = "cart-card cart-package-card";

                    const imageHtml = item.imageBase64 && item.imageContentType
                        ? `<img src="data:${item.imageContentType};base64,${item.imageBase64}" alt="${escapeHtml(item.name)}" class="cart-image" />`
                        : `<div class="cart-image cart-image-placeholder">No Image</div>`;

                    card.innerHTML = `
                        ${imageHtml}

                        <div class="cart-content">
                            <div class="cart-title-row">
                                <h3>${escapeHtml(item.name)}</h3>
                                <span class="menu-price">${formatMoney(lineTotal)}</span>
                            </div>

                            <div class="cart-meta">
                                Price Per Person: ${formatMoney(item.finalUnitPrice)}
                            </div>

                            <div class="cart-meta">
                                Guest Range: ${minGuestCount} - ${maxGuestCount}
                            </div>

                            ${renderSelectedOptions(item)}

                            <div class="cart-guest-editor">
                                <label>Guest Count</label>

                                <div class="package-guest-stepper">
                                    <button type="button" class="guest-step-btn" data-step="-100">-100</button>
                                    <button type="button" class="guest-step-btn" data-step="-10">-10</button>

                                    <input type="number"
                                           class="form-control package-guest-input cart-guest-input"
                                           min="${minGuestCount}"
                                           max="${maxGuestCount}"
                                           value="${item.quantity}" />

                                    <button type="button" class="guest-step-btn" data-step="10">+10</button>
                                    <button type="button" class="guest-step-btn" data-step="100">+100</button>
                                </div>

                                <small class="text-muted">
                                    You can also type the guest count manually.
                                </small>
                            </div>

                            <div class="cart-meta">
                                Package Total: <strong>${formatMoney(lineTotal)}</strong>
                            </div>

                            <div class="cart-actions">
                                <button class="delete-link-button btn-remove" type="button">
                                    Remove Package
                                </button>
                            </div>
                        </div>
                    `;

                    card.querySelectorAll("[data-step]").forEach(button => {
                        button.addEventListener("click", function () {
                            const step = Number.parseInt(button.dataset.step || "0", 10);
                            changeQuantity(item.signature, step);
                        });
                    });

                    const input = card.querySelector(".cart-guest-input");

                    input.addEventListener("change", function () {
                        updateQuantity(item.signature, input.value);
                    });

                    input.addEventListener("keydown", function (event) {
                        if (event.key === "Enter") {
                            event.preventDefault();
                            updateQuantity(item.signature, input.value);
                        }
                    });

                    card.querySelector(".btn-remove").addEventListener("click", function () {
                        removeItem(item.signature);
                    });

                    container.appendChild(card);
                });

                totalBox.textContent = "Total Price: " + formatMoney(getTotal(cart));
                syncAgreementCartJson();
            }

            if (agreementForm) {
                agreementForm.addEventListener("submit", function (event) {
                    const cart = window.TasteAtDoorCart.getCart();

                    if (!cart || cart.length === 0) {
                        event.preventDefault();
                        alert("Your package cart is empty.");
                        return;
                    }

                    cartJsonInput.value = JSON.stringify(cart);
                });
            }

            render();
        });
    </script>
}

