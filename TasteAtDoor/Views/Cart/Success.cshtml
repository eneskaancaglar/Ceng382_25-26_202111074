@model TasteAtDoor.Models.ViewModels.OrderSuccessViewModel

@{
    ViewData["Title"] = "Order Completed";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Order Completed</h1>
        <p>Your payment has been processed successfully.</p>

        <div class="order-success-box">
            <div><strong>Order ID:</strong> @Model.OrderId</div>
            <div><strong>Order Date:</strong> @Model.OrderDate</div>
            <div><strong>Status:</strong> @Model.Status</div>
            <div><strong>Total Price:</strong> @Model.TotalPrice.ToString("0.00")</div>
        </div>

        <div class="hero-buttons">
            <a asp-controller="User"
               asp-action="Receipt"
               asp-route-id="@Model.OrderId"
               class="btn-main">
                View Receipt
            </a>

            <a asp-controller="OrderDocument"
               asp-action="ReceiptPdf"
               asp-route-id="@Model.OrderId"
               class="btn-secondary-main">
                Download Receipt PDF
            </a>

            <a asp-controller="OrderDocument"
               asp-action="AgreementPdf"
               asp-route-id="@Model.OrderId"
               class="btn-secondary-main">
                Download Agreement PDF
            </a>

            <a asp-controller="OrderChat"
               asp-action="Room"
               asp-route-orderId="@Model.OrderId"
               class="btn-main">
                Open Order Chat
            </a>

            <a asp-controller="User"
               asp-action="Index"
               class="btn-secondary-main">
                Back to Restaurants
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            localStorage.removeItem("tasteAtDoorCart");
        });
    </script>
}