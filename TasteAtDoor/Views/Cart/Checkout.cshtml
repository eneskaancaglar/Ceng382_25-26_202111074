@model TasteAtDoor.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="dashboard-shell">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">Payment</h1>
            <p class="page-subtitle">Complete your order with a simulated payment.</p>
        </div>

        <a asp-controller="Cart" asp-action="Index" class="btn-secondary-main">
            Back to Cart
        </a>
    </div>

    <div class="checkout-layout">
        <div class="table-card">
            <h3 class="section-title">Order Summary</h3>

            <div id="checkout-empty-state" class="empty-box" style="display:none;">
                <h3>Your cart is empty</h3>
                <p>Please go back and add items before checkout.</p>
            </div>

            <div id="checkout-summary-stack" class="checkout-summary-stack"></div>

            <div id="checkout-total-box" class="checkout-total-box" style="display:none;">
                Total Price: <strong id="checkout-total-price">0.00</strong>
            </div>
        </div>

        <div class="auth-card">
            <h3 class="section-title">Card Information</h3>
            <p class="page-subtitle">
                This is a simulation only. Do not enter a real card number.
            </p>

            <form asp-controller="Cart" asp-action="Checkout" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="CartJson" type="hidden" id="CartJson" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="CardHolderName">Card Holder Name</label>
                    <input asp-for="CardHolderName"
                           class="form-control"
                           placeholder="Demo User" />
                    <span asp-validation-for="CardHolderName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CardNumber">Card Number</label>
                    <input asp-for="CardNumber"
                           class="form-control"
                           placeholder="4111111111111111" />
                    <span asp-validation-for="CardNumber" class="text-danger"></span>
                    <small class="text-muted">Use demo data only.</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="ExpiryDate">Expiry Date</label>
                            <input asp-for="ExpiryDate"
                                   class="form-control"
                                   placeholder="12/30" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="CVV">CVV</label>
                            <input asp-for="CVV"
                                   class="form-control"
                                   placeholder="123" />
                            <span asp-validation-for="CVV" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-main w-100">
                    Complete Simulated Payment
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const CART_KEY = "tasteAtDoorCart";

            function parseNumber(value, fallback = 0) {
                const n = Number(value);
                return Number.isFinite(n) ? n : fallback;
            }

            function getRawCart() {
                const json = localStorage.getItem(CART_KEY);

                if (!json) {
                    return [];
                }

                try {
                    return JSON.parse(json);
                } catch {
                    return [];
                }
            }

            function normalizeOption(raw) {
                return {
                    groupId: parseNumber(raw?.groupId ?? raw?.GroupId),
                    groupTitle: raw?.groupTitle ?? raw?.GroupTitle ?? "",
                    optionId: parseNumber(raw?.optionId ?? raw?.OptionId),
                    optionName: raw?.optionName ?? raw?.OptionName ?? "",
                    priceChange: parseNumber(raw?.priceChange ?? raw?.PriceChange)
                };
            }

            function normalizeItem(raw) {
                const baseUnitPrice = parseNumber(
                    raw?.baseUnitPrice ??
                    raw?.BaseUnitPrice ??
                    raw?.price ??
                    raw?.Price ??
                    raw?.unitPrice ??
                    raw?.UnitPrice
                );

                const finalUnitPrice = parseNumber(
                    raw?.finalUnitPrice ??
                    raw?.FinalUnitPrice ??
                    raw?.price ??
                    raw?.Price ??
                    raw?.unitPrice ??
                    raw?.UnitPrice ??
                    baseUnitPrice
                );

                const selectedOptionsRaw = raw?.selectedOptions ?? raw?.SelectedOptions ?? [];

                return {
                    signature: raw?.signature ?? raw?.Signature ?? "",
                    menuItemId: parseNumber(raw?.menuItemId ?? raw?.MenuItemId),
                    name: raw?.name ?? raw?.Name ?? "",
                    description: raw?.description ?? raw?.Description ?? "",
                    baseUnitPrice: baseUnitPrice,
                    finalUnitPrice: finalUnitPrice,
                    quantity: parseNumber(raw?.quantity ?? raw?.Quantity, 1),
                    imageContentType: raw?.imageContentType ?? raw?.ImageContentType ?? "",
                    imageBase64: raw?.imageBase64 ?? raw?.ImageBase64 ?? "",
                    selectedOptions: Array.isArray(selectedOptionsRaw)
                        ? selectedOptionsRaw.map(normalizeOption)
                        : []
                };
            }

            function getCart() {
                return getRawCart()
                    .map(normalizeItem)
                    .filter(x => x.menuItemId > 0 && x.name);
            }

            function escapeHtml(value) {
                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function renderSelectedOptions(item) {
                if (!item.selectedOptions || item.selectedOptions.length === 0) {
                    return `<div class="cart-meta">No customization selected</div>`;
                }

                const items = item.selectedOptions.map(option => {
                    const priceHtml = option.priceChange !== 0
                        ? ` <span class="option-price-change">(${option.priceChange.toFixed(2)})</span>`
                        : "";

                    return `<li>${escapeHtml(option.groupTitle)}: ${escapeHtml(option.optionName)}${priceHtml}</li>`;
                }).join("");

                return `<ul class="user-option-list">${items}</ul>`;
            }

            const cart = getCart();
            const cartJsonInput = document.getElementById("CartJson");

            if (cartJsonInput) {
                cartJsonInput.value = JSON.stringify(cart);
            }

            const emptyBox = document.getElementById("checkout-empty-state");
            const summaryStack = document.getElementById("checkout-summary-stack");
            const totalBox = document.getElementById("checkout-total-box");
            const totalText = document.getElementById("checkout-total-price");

            if (cart.length === 0) {
                emptyBox.style.display = "block";
                totalBox.style.display = "none";
                return;
            }

            emptyBox.style.display = "none";
            totalBox.style.display = "block";

            let total = 0;

            cart.forEach(item => {
                const lineTotal = item.finalUnitPrice * item.quantity;
                total += lineTotal;

                const row = document.createElement("div");
                row.className = "checkout-summary-row";
                row.innerHTML = `
                    <div>
                        <strong>${escapeHtml(item.name)}</strong>
                        <div class="cart-meta">Quantity: ${item.quantity}</div>
                        <div class="cart-meta">Base Price: ${item.baseUnitPrice.toFixed(2)}</div>
                        <div class="cart-meta">Final Unit Price: ${item.finalUnitPrice.toFixed(2)}</div>
                        ${renderSelectedOptions(item)}
                    </div>
                    <div class="menu-price">${lineTotal.toFixed(2)}</div>
                `;

                summaryStack.appendChild(row);
            });

            totalText.textContent = total.toFixed(2);
        });
    </script>
}