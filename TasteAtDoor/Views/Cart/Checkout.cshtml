@model TasteAtDoor.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Event Checkout";
}

<div class="dashboard-shell">
    <div class="page-header-row">
        <div>
            <h1 class="page-title">Event Checkout</h1>
            <p class="page-subtitle">
                Confirm your catering packages, event details, guest count, and simulated payment.
            </p>
        </div>

        <a asp-controller="Cart" asp-action="Index" class="btn-secondary-main">
            Back to Package Cart
        </a>
    </div>

    <div class="checkout-layout">
        <div class="table-card">
            <h3 class="section-title">Catering Request Summary</h3>

            <div id="checkout-empty-state" class="empty-box" style="display:none;">
                <h3>Your cart is empty</h3>
                <p>Please go back and add catering packages before checkout.</p>
            </div>

            <div id="checkout-summary-stack" class="checkout-summary-stack"></div>

            <div id="checkout-total-box" class="checkout-total-box" style="display:none;">
                <div>Total Estimated Price: <strong id="checkout-total-price">0.00</strong></div>
                <div>Total Guest Count: <strong id="checkout-total-guests">0</strong></div>
            </div>
        </div>

        <div class="auth-card">
            <h3 class="section-title">Event Information</h3>
            <p class="page-subtitle">
                These details will be sent to the selected caterer after payment simulation.
            </p>

            <form asp-controller="Cart" asp-action="Checkout" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="CartJson" type="hidden" id="CartJson" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="EventType"></label>
                    <select asp-for="EventType" class="form-control">
                        <option value="Wedding">Wedding</option>
                        <option value="Engagement">Engagement</option>
                        <option value="Corporate Event">Corporate Event</option>
                        <option value="Birthday">Birthday</option>
                        <option value="Graduation">Graduation</option>
                        <option value="Meeting">Meeting</option>
                        <option value="General Event">General Event</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventDate"></label>
                    <input asp-for="EventDate"
                           type="datetime-local"
                           class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="GuestCount"></label>
                    <input asp-for="GuestCount"
                           id="GuestCount"
                           type="number"
                           min="1"
                           max="100000"
                           class="form-control" />
                    <span asp-validation-for="GuestCount" class="text-danger"></span>
                    <small class="text-muted">
                        This will be filled from your cart automatically. You can still edit it if needed.
                    </small>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventAddress"></label>
                    <textarea asp-for="EventAddress"
                              class="form-control"
                              rows="3"
                              placeholder="Full event address, venue name, floor, hall name, etc."></textarea>
                    <span asp-validation-for="EventAddress" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventNote"></label>
                    <textarea asp-for="EventNote"
                              class="form-control"
                              rows="3"
                              placeholder="Example: delivery time, setup instructions, vegetarian options, service staff request..."></textarea>
                    <span asp-validation-for="EventNote" class="text-danger"></span>
                </div>

                <hr />

                <h3 class="section-title">Simulated Payment</h3>
                <p class="page-subtitle">
                    This is a simulation only. Do not enter a real card number.
                </p>

                <div class="form-group mb-3">
                    <label asp-for="CardHolderName"></label>
                    <input asp-for="CardHolderName"
                           class="form-control"
                           placeholder="Demo User" />
                    <span asp-validation-for="CardHolderName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CardNumber"></label>
                    <input asp-for="CardNumber"
                           class="form-control"
                           placeholder="4111111111111111" />
                    <span asp-validation-for="CardNumber" class="text-danger"></span>
                    <small class="text-muted">Use demo data only.</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="ExpiryDate"></label>
                            <input asp-for="ExpiryDate"
                                   class="form-control"
                                   placeholder="12/30" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="CVV"></label>
                            <input asp-for="CVV"
                                   class="form-control"
                                   placeholder="123" />
                            <span asp-validation-for="CVV" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-main w-100">
                    Complete Catering Request
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/cart-storage.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (!window.TasteAtDoorCart) {
                return;
            }

            function formatMoney(value) {
                return new Intl.NumberFormat("tr-TR", {
                    style: "currency",
                    currency: "TRY"
                }).format(value);
            }

            function escapeHtml(value) {
                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function renderSelectedOptions(item) {
                if (!item.selectedOptions || item.selectedOptions.length === 0) {
                    return `<div class="cart-meta">No extra package option selected</div>`;
                }

                const items = item.selectedOptions.map(option => {
                    const priceHtml = option.priceChange !== 0
                        ? ` <span class="option-price-change">(${formatMoney(option.priceChange)} / person)</span>`
                        : "";

                    return `<li>${escapeHtml(option.groupTitle)}: ${escapeHtml(option.optionName)}${priceHtml}</li>`;
                }).join("");

                return `<ul class="user-option-list">${items}</ul>`;
            }

            const cart = window.TasteAtDoorCart.getCart();
            const cartJsonInput = document.getElementById("CartJson");

            if (cartJsonInput) {
                cartJsonInput.value = JSON.stringify(cart);
            }

            const emptyBox = document.getElementById("checkout-empty-state");
            const summaryStack = document.getElementById("checkout-summary-stack");
            const totalBox = document.getElementById("checkout-total-box");
            const totalText = document.getElementById("checkout-total-price");
            const totalGuestsText = document.getElementById("checkout-total-guests");
            const guestCountInput = document.getElementById("GuestCount");

            if (cart.length === 0) {
                emptyBox.style.display = "block";
                totalBox.style.display = "none";
                return;
            }

            emptyBox.style.display = "none";
            totalBox.style.display = "block";

            let total = 0;
            let totalGuests = 0;

            cart.forEach(item => {
                const guestCount = Number.parseInt(item.quantity || "0", 10);
                const lineTotal = item.finalUnitPrice * guestCount;

                total += lineTotal;
                totalGuests += guestCount;

                const row = document.createElement("div");
                row.className = "checkout-summary-row";

                row.innerHTML = `
                    <div>
                        <strong>${escapeHtml(item.name)}</strong>
                        <div class="cart-meta">Guest Count: ${guestCount}</div>
                        <div class="cart-meta">Price Per Person: ${formatMoney(item.finalUnitPrice)}</div>
                        <div class="cart-meta">Guest Range: ${item.minGuestCount || 1} - ${item.maxGuestCount || 100000}</div>
                        ${renderSelectedOptions(item)}
                    </div>
                    <div class="menu-price">${formatMoney(lineTotal)}</div>
                `;

                summaryStack.appendChild(row);
            });

            totalText.textContent = formatMoney(total);
            totalGuestsText.textContent = totalGuests.toString();

            if (guestCountInput && totalGuests > 0) {
                guestCountInput.value = totalGuests;
            }

            document.querySelectorAll("form").forEach(form => {
                form.addEventListener("submit", function () {
                    if (cartJsonInput) {
                        cartJsonInput.value = JSON.stringify(window.TasteAtDoorCart.getCart());
                    }
                });
            });
        });
    </script>
}

