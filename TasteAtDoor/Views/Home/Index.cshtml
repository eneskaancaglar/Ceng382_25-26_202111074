@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-box">
        <img src="~/images/logo.png" alt="Taste At Door Logo" class="hero-logo" />
        <h1>Taste At Door</h1>
        <p class="hero-text">Premium catering delivered to your door.</p>

        <div class="hero-buttons">
            <a asp-controller="User" asp-action="Index" class="btn-main">Browse Menus</a>
            <a asp-controller="Account" asp-action="Register" class="btn-secondary-main">Create Account</a>
        </div>
    </div>
</section>

<section class="cards-section">
    <div class="info-card">
        <h3>Premium Experience</h3>
        <p>Elegant branding, clean layout, and a refined user experience for catering services.</p>
    </div>

    <div class="info-card">
        <h3>Dynamic Menus</h3>
        <p>Caretakers can create menu items, upload images, and define flexible customization groups.</p>
    </div>

    <div class="info-card">
        <h3>Smart Ordering Flow</h3>
        <p>Users can browse menus, view customizations, and continue through the ordering flow in later weeks.</p>
    </div>
</section>