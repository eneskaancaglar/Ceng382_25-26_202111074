@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-box">
        <img src="~/images/logo.png" alt="Taste At Door Logo" class="hero-logo" />
        <h1>Taste At Door</h1>
        <p class="hero-text">Premium catering delivered to your door.</p>

        <div class="hero-buttons">
            <a href="#" class="btn-main">Explore Menu</a>
            <a href="#" class="btn-secondary-main">Browse Restaurants</a>
        </div>
    </div>
</section>

<section class="cards-section">
    <div class="info-card">
        <h3>Premium Experience</h3>
        <p>A refined catering platform with an elegant look and a strong visual identity.</p>
    </div>

    <div class="info-card">
        <h3>Nearby Choices</h3>
        <p>The project structure is being prepared to show restaurants based on user location.</p>
    </div>

    <div class="info-card">
        <h3>Easy Ordering</h3>
        <p>Cart, payment, and order tracking features will be added on top of this starter structure.</p>
    </div>
</section>