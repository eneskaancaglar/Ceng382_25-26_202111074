@model TasteAtDoor.Models.ViewModels.OrderItemReviewCreateViewModel

@{
    ViewData["Title"] = "Rate Catering Package";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Rate Catering Package</h1>

        <p>
            Submit a package rating, a caterer rating, and your comment.
        </p>

        <div class="order-success-box">
            <div><strong>Request ID:</strong> #@Model.OrderId</div>
            <div><strong>Catering Package:</strong> @Model.MenuItemName</div>
            <div><strong>Caterer:</strong> @Model.CatererName</div>
        </div>

        <form asp-controller="OrderReview" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="OrderItemId" type="hidden" />
            <input asp-for="OrderId" type="hidden" />
            <input asp-for="MenuItemName" type="hidden" />
            <input asp-for="CatererName" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="MenuRating">Package Rating (1-5)</label>
                <input asp-for="MenuRating"
                       class="form-control"
                       type="number"
                       min="1"
                       max="5" />
                <span asp-validation-for="MenuRating" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CatererRating">Caterer Rating (1-5)</label>
                <input asp-for="CatererRating"
                       class="form-control"
                       type="number"
                       min="1"
                       max="5" />
                <span asp-validation-for="CatererRating" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Comment">Comment</label>
                <textarea asp-for="Comment"
                          class="form-control"
                          rows="5"
                          placeholder="Write your review about this package and caterer..."></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn-main">
                    Submit Review
                </button>

                <a asp-controller="User"
                   asp-action="Orders"
                   class="btn-secondary-main">
                    Back to My Requests
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

