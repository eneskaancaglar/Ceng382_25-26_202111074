@page
@model Lab3.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Segoe UI", sans-serif;
            background: #f5f7fb;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .register-card {
            width: 100%;
            max-width: 560px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            padding: 32px 28px;
        }

        .title {
            text-align: center;
            margin-bottom: 8px;
            font-size: 2rem;
            font-weight: 700;
            color: #1e293b;
        }

        .subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 24px;
            font-size: 0.95rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .full {
            grid-column: 1 / -1;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .input-group label {
            font-size: 0.9rem;
            color: #334155;
            font-weight: 600;
        }

        .input-group input {
            padding: 12px 14px;
            border: 1px solid #dbe2ea;
            border-radius: 12px;
            font-size: 0.95rem;
            outline: none;
        }

        .input-group input:focus {
            border-color: #a78bfa;
            box-shadow: 0 0 0 3px rgba(167,139,250,0.15);
        }

        .file-box {
            border: 2px dashed #d1d5db;
            border-radius: 14px;
            padding: 16px;
            background: #fafafa;
        }

        .file-box input[type="file"] {
            border: none;
            padding: 0;
            background: transparent;
            box-shadow: none;
        }

        .btn {
            width: 100%;
            margin-top: 22px;
            border: none;
            border-radius: 999px;
            padding: 14px;
            background: #b58b78;
            color: white;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn:hover {
            opacity: 0.92;
        }

        .message-success {
            background: #ecfdf5;
            color: #166534;
            border: 1px solid #86efac;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 16px;
        }

        .message-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fca5a5;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 16px;
        }

        .password-hint {
            margin-top: 6px;
            font-size: 0.82rem;
            color: #64748b;
            line-height: 1.5;
        }

        .bottom-link {
            text-align: center;
            margin-top: 18px;
        }

        .bottom-link a {
            color: #7c3aed;
            text-decoration: none;
            font-weight: 600;
        }

        @@media (max-width: 640px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="register-card">
        <h1 class="title">Register</h1>
        <p class="subtitle">Create your account and complete your profile.</p>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="message-success">@Model.SuccessMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="message-error">@Model.ErrorMessage</div>
        }

        <form method="post" enctype="multipart/form-data">
            <div class="form-grid">
                <div class="input-group">
                    <label>Name</label>
                    <input asp-for="Input.Name" />
                </div>

                <div class="input-group">
                    <label>Surname</label>
                    <input asp-for="Input.Surname" />
                </div>

                <div class="input-group full">
                    <label>Address</label>
                    <input asp-for="Input.Address" />
                </div>

                <div class="input-group full">
                    <label>Profile Photo</label>
                    <div class="file-box">
                        <input asp-for="ProfilePhoto" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    </div>
                </div>

                <div class="input-group full">
                    <label>Email</label>
                    <input asp-for="Input.Email" />
                </div>

                <div class="input-group">
                    <label>Password</label>
                    <input asp-for="Input.Password" type="password" />
                </div>

                <div class="input-group">
                    <label>Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" />
                </div>
            </div>

            <div class="password-hint">
                Password en az 8 karakter olmalı, en az 1 büyük harf ve 1 rakam içermelidir.
            </div>

            <button type="submit" class="btn">Register</button>
        </form>

        <div class="bottom-link">
            <a href="/Index">Back to Home</a>
        </div>
    </div>
</body>
</html>